{
  "id": "wazuhActResp0001",
  "name": "SOAR: Wazuh Active Response",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner"
  },
  "nodes": [
    {
      "id": "b0000000-0000-4000-8000-000000000001",
      "name": "Called by triage",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "command"
            },
            {
              "name": "srcip"
            }
          ]
        }
      }
    },
    {
      "id": "b0000000-0000-4000-8000-000000000002",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Defence in depth: only allow known commands and a plain IPv4 address,\n// even though the caller and the agent-side script also validate.\nconst ALLOWED = ['!firewall-drop', '!purplen8-unblock'];\nconst { command, srcip } = $json;\n\nif (!ALLOWED.includes(command)) throw new Error(`Command not allowed: ${command}`);\nif (!/^(\\d{1,3}\\.){3}\\d{1,3}$/.test(srcip ?? '') || srcip.split('.').some(n => Number(n) > 255)) {\n  throw new Error(`Invalid IPv4 address: ${srcip}`);\n}\nreturn { json: { command, srcip } };"
      }
    },
    {
      "id": "b0000000-0000-4000-8000-000000000003",
      "name": "Wazuh Login",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "credentials": {
        "httpBasicAuth": {
          "id": "purplen8WazuhApi",
          "name": "Wazuh API (purplen8)"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "https://wazuh.manager:55000/security/user/authenticate?raw=true",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "options": {
          "allowUnauthorizedCerts": true,
          "response": {
            "response": {
              "responseFormat": "text",
              "outputPropertyName": "token"
            }
          }
        }
      }
    },
    {
      "id": "b0000000-0000-4000-8000-000000000004",
      "name": "Run Active Response",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "method": "PUT",
        "url": "https://wazuh.manager:55000/active-response",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.token }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ command: $('Validate Input').item.json.command, alert: { data: { srcip: $('Validate Input').item.json.srcip } } }) }}",
        "options": {
          "allowUnauthorizedCerts": true,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "b0000000-0000-4000-8000-000000000005",
      "name": "Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Summarise the Wazuh API response for the caller\nconst r = $json;\nconst affected = r?.data?.affected_items ?? [];\nreturn { json: {\n  ok: r?.error === 0 && affected.length > 0,\n  agents: affected,\n  message: r?.message ?? 'no response from Wazuh API',\n} };"
      }
    }
  ],
  "connections": {
    "Called by triage": {
      "main": [
        [
          {
            "node": "Validate Input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Input": {
      "main": [
        [
          {
            "node": "Wazuh Login",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wazuh Login": {
      "main": [
        [
          {
            "node": "Run Active Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Active Response": {
      "main": [
        [
          {
            "node": "Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}