    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Pull the fields we care about out of a raw Wazuh alert.\n// Wazuh stores the source IP in different places depending on the log type.\nconst a = $json.body;\nconst d = a.data || {};\nconst srcip = d.srcip || d.src_ip || d.win?.eventdata?.ipAddress || null;\n\n// RFC1918 / loopback / link-local addresses can't be looked up publicly\nconst isPrivate = (ip) =>\n  /^(10\\.|127\\.|192\\.168\\.|172\\.(1[6-9]|2\\d|3[01])\\.|169\\.254\\.)/.test(ip) || ip === '::1' || ip === '-';\n\nreturn { json: {\n  alertId: a.id,\n  time: a.timestamp,\n  ruleId: a.rule?.id,\n  level: Number(a.rule?.level ?? 0),\n  description: a.rule?.description ?? 'Unknown rule',\n  groups: a.rule?.groups ?? [],\n  mitre: a.rule?.mitre?.id ?? [],\n  agent: a.agent?.name ?? 'unknown',\n  srcip,\n  srcuser: d.srcuser || d.dstuser || d.win?.eventdata?.targetUserName || null,\n  log: a.full_log ?? '',\n  publicIp: !!srcip && !isPrivate(srcip),\n} };"
      },
      "id": "a0000000-0000-4000-8000-000000000002",
      "name": "Normalise Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        304
      ]
    },
    {
