              "id": "a0000000-0000-4000-8000-0000000000c9",
              "leftValue": "={{ $json.publicIp }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a0000000-0000-4000-8000-000000000003",
      "name": "Public IP?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        448,
        304
      ]
    },
    {
      "parameters": {
        "url": "=http://enrich:8080/lookup/{{ $json.srcip }}",
        "options": {}
      },
      "id": "a0000000-0000-4000-8000-000000000004",
      "name": "Lookup IP",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        672,
        208
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// The normalised alert (reached back past the IP lookup)\nconst alert = $('Normalise Alert').item.json;\n// Enrichment only exists if the alert went through \"Lookup IP\" successfully\nconst geo = $json.status === 'success' ? $json : null;\n\nconst HOME = ($env.HOME_COUNTRIES || 'United Kingdom').split(',').map(s => s.trim());\n\n// --- Scoring rules (tune these) ---\nlet score = alert.level * 4;                 // Wazuh level 0-15  ->  0-60\nconst reasons = [`Wazuh level ${alert.level}`];\n\nif (geo) {\n  if (geo.tor)     { score += 30; reasons.push('Tor exit node'); }\n  if (geo.hosting) { score += 15; reasons.push('datacenter / hosting'); }\n  if (geo.country && !HOME.includes(geo.country)) { score += 10; reasons.push(`outside home countries (${geo.country})`); }\n} else if (alert.srcip && !alert.publicIp) {\n  reasons.push('internal source IP');\n}\nif (alert.groups.includes('attack')) { score += 10; reasons.push('rule group: attack'); }\n\nscore = Math.min(score, 100);\nconst severity = score >= 70 ? 'high' : score >= 40 ? 'medium' : 'low';\n\n// Escape anything that came from logs before it goes into a Telegram message\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');   // HTML\nconst md  = (s) => String(s ?? '').replace(/[&<>]/g, '').replace(/([_*`\\[])/g, '\\\\$1');                // Markdown\n\nreturn { json: {\n  ...alert,\n  country: geo?.country ?? null,\n  isp: geo?.isp ?? null,\n  score,\n  severity,\n  reasons,\n  safe: {\n    description: esc(alert.description),\n    agent: esc(alert.agent),\n    user: esc(alert.srcuser),\n    isp: esc(geo?.isp),\n    log: esc(alert.log.slice(0, 300)),\n  },\n  md: {\n    description: md(alert.description),\n    agent: md(alert.agent),\n    user: md(alert.srcuser),\n    place: geo?.country ? md(`${geo.country}, ${geo.isp}`) : '',\n    reasons: md(reasons.join('; ')),\n  },\n} };"
      },
