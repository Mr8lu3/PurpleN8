      "id": "a0000000-0000-4000-8000-00000000000b",
      "name": "Dedupe (Postgres)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1100,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "purplen8Postgres",
          "name": "PurpleN8 Postgres"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Atomic dedupe: insert the key, or refresh it only if the last notification\n-- was more than 10 minutes ago. Concurrent alerts for the same key wait on the\n-- row lock, so only one of them can ever be \"new\".\nWITH sent AS (\n  INSERT INTO dedupe_window (key, last_sent) VALUES ($1, now())\n  ON CONFLICT (key) DO UPDATE SET last_sent = now()\n    WHERE dedupe_window.last_sent < now() - interval '10 minutes'\n  RETURNING 1\n)\nSELECT EXISTS (SELECT 1 FROM sent) AS is_new;",
        "options": {
          "queryReplacement": "={{ [($json.srcip ? $json.srcip : $json.agent + '|' + $json.description) + '|' + $json.ruleId] }}"
        }
      }
    },
    {
      "id": "a0000000-0000-4000-8000-00000000000c",
      "name": "Decide Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Combine the scored alert with the dedupe result and decide what happens to it\nconst alert = $('Score Alert').item.json;\nconst duplicate = !$json.is_new;\nconst action = duplicate ? 'suppressed' : alert.severity === 'low' ? 'logged' : 'notified';\n\nreturn { json: {\n  ...alert,\n  duplicate,\n  action,\n  // Row for the audit log (keys match the alert_log columns)\n  logRecord: {\n    alert_id: alert.alertId, alert_time: alert.time, rule_id: alert.ruleId, level: alert.level,\n    description: alert.description, agent: alert.agent, srcip: alert.srcip, srcuser: alert.srcuser,\n    country: alert.country, isp: alert.isp, mitre: alert.mitre, score: alert.score,\n    severity: alert.severity, reasons: alert.reasons, action,\n  },\n} };"
      }
    },
    {
      "id": "a0000000-0000-4000-8000-00000000000d",
      "name": "Audit Log",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1540,
        60
      ],
      "credentials": {
        "postgres": {
          "id": "purplen8Postgres",
          "name": "PurpleN8 Postgres"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Write one audit row. The whole record is passed as a single JSON parameter.\nINSERT INTO alert_log (alert_id, alert_time, rule_id, level, description, agent, srcip, srcuser,\n                       country, isp, mitre, score, severity, reasons, action)\nSELECT alert_id, alert_time, rule_id, level, description, agent, srcip, srcuser,\n       country, isp, mitre, score, severity, reasons, action\nFROM jsonb_to_record($1::jsonb) AS r(\n  alert_id text, alert_time text, rule_id text, level int, description text, agent text,\n  srcip text, srcuser text, country text, isp text, mitre jsonb, score int,\n  severity text, reasons jsonb, action text);",
        "options": {
          "queryReplacement": "={{ [JSON.stringify($json.logRecord)] }}"
        }
      }
    },
