# PurpleN8 configuration. Copy to .env (cp .env.example .env) and fill in the first section.
# .env is git-ignored: it never leaves your machine.

# --- You fill these in ---------------------------------------------------------
# Telegram bot token from @BotFather, and your own chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional -------------------------------------------------------------------
# Countries treated as "home" by the risk scorer (comma separated, English names)
HOME_COUNTRIES=United Kingdom
# How long an approved block lasts before it is lifted automatically (minutes)
BLOCK_MINUTES=60
# URL used in Telegram Block/Ignore buttons. Empty = http://127.0.0.1:5678/ (this PC only).
# Set to http://<your-PC-LAN-IP>:5678/ to tap buttons from your phone on the same Wi-Fi
# (also change the n8n port binding in docker-compose.yml to 0.0.0.0:5678:5678).
N8N_PUBLIC_URL=

# --- Generated by setup.sh if empty ---------------------------------------------
POSTGRES_PASSWORD=
WEBHOOK_TOKEN=
WAZUH_ADMIN_PASSWORD=
WAZUH_API_USER=purplen8
WAZUH_API_PASSWORD=
# Pentest: hostnames the engagement form will accept as targets (comma separated)
PENTEST_ALLOWED_HOSTS=juice-shop
